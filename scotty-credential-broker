#!/usr/bin/env python3
"""Run the root-owned credential broker on its fixed socket.

Started by systemd as root. It holds provider credentials outside the container
so the model-visible runtime can ask whether a provider is connected but can
never read what is stored.

The root precondition is checked before anything is imported from the installed
tree. Importing first would mean a non-root invocation on a machine without the
package failed with an import error rather than the refusal this promises, and a
refusal that depends on where the code happens to be installed is not a refusal.
"""

from __future__ import annotations

import os
import sys


def main() -> int:
    if os.geteuid() != 0:
        print("scotty-credential-broker: must run as root", file=sys.stderr)
        return 1

    import json
    import signal
    import threading
    from contextlib import suppress
    from pathlib import Path

    # Root-owned and outside every mount the container can write to.
    sys.path.insert(0, "/usr/local/lib/scotty")
    from scotty_broker.broker import (
        ACTOR_SOCKETS,
        SOCKET_PATH,
        STORE_PATH,
        Broker,
        CredentialStore,
        bind_actor_socket,
        bind_control_socket,
        serve_all,
    )
    from scotty_broker.effects import EFFECTS_PATH, EffectLedger
    from scotty_broker.executor import Executor
    from scotty_broker.google import GoogleTokenMinter
    from scotty_broker.grants import GRANTS_PATH, GrantStore
    from scotty_broker.provenance import ProvenanceResolver, routes_from

    os.umask(0o077)
    stop = threading.Event()
    for received in (signal.SIGTERM, signal.SIGINT):
        signal.signal(received, lambda *_: stop.set())

    store = CredentialStore(STORE_PATH)
    grants = GrantStore(GRANTS_PATH)
    effects = EffectLedger(EFFECTS_PATH)
    effects.initialize()

    # Who is asking is settled here, from Discord, using a token copy the
    # container does not have. Without a route map the broker still runs and
    # still refuses every provider call, which is the right failure: an
    # unconfigured deployment must not act on somebody's behalf.
    routes = ()
    route_path = Path("/var/lib/scotty/routes.json")
    if route_path.is_file() and not route_path.is_symlink():
        with suppress(OSError, ValueError):
            routes = routes_from(json.loads(route_path.read_text(encoding="utf-8")))
    resolver = ProvenanceResolver(routes, lambda: store.read("discord", "bot_token", "shared"))

    # The executor is the only thing that puts a credential on a request, and
    # it lives here, in the root-owned process, outside every mount.
    # Google's refresh tokens and client secret are held here and exchanged
    # here. What crosses to the container is an access token good for about an
    # hour, which cannot mint another.
    broker = Broker(
        store,
        executor=Executor(store, grants),
        grants=grants,
        effects=effects,
        provenance=resolver,
        google=GoogleTokenMinter(store),
    )

    sockets = {"control": bind_control_socket(SOCKET_PATH)}
    for actor in sorted(ACTOR_SOCKETS):
        group = _group_for(actor)
        if group is None:
            # The account for that actor is not installed on this host, so the
            # socket is not created. Nothing can reach an actor that is absent.
            continue
        sockets[actor] = bind_actor_socket(actor, group=group)
    try:
        serve_all(broker, sockets, should_stop=stop.is_set)
    finally:
        for actor, server in sockets.items():
            server.close()
            path = SOCKET_PATH if actor == "control" else ACTOR_SOCKETS[actor]
            with suppress(OSError):
                os.unlink(path)
    return 0


def _group_for(actor: str) -> int | None:
    """That actor's own group, if this host has one."""

    import grp

    try:
        return grp.getgrnam("scotty-" + actor.replace("_", "-")).gr_gid
    except KeyError:
        return None


if __name__ == "__main__":
    raise SystemExit(main())
