#!/usr/bin/env python3
"""Run the root-owned credential broker on its fixed socket.

Started by systemd as root. It holds provider credentials outside the container
so the model-visible runtime can ask whether a provider is connected but can
never read what is stored.
"""

from __future__ import annotations

import os
import signal
import sys
import threading
from contextlib import suppress

# Root-owned and outside every mount the container can write to.
sys.path.insert(0, "/usr/local/lib/scotty")

from scotty_broker.broker import (  # noqa: E402
    SOCKET_PATH,
    STORE_PATH,
    Broker,
    CredentialStore,
    bind_socket,
    serve_forever,
)


def main() -> int:
    if os.geteuid() != 0:
        print("scotty-credential-broker: must run as root", file=sys.stderr)
        return 1
    os.umask(0o077)
    stop = threading.Event()
    for received in (signal.SIGTERM, signal.SIGINT):
        signal.signal(received, lambda *_: stop.set())
    broker = Broker(CredentialStore(STORE_PATH))
    server = bind_socket(SOCKET_PATH)
    try:
        serve_forever(broker, server, should_stop=stop.is_set)
    finally:
        server.close()
        with suppress(OSError):
            os.unlink(SOCKET_PATH)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
